# API key for https://aitts.theproductivepixel.com (create one in your account)
TTS_API_KEY=

# Public origin used for canonical URLs, sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In production point this at the public origin, e.g. https://speakshelf.com

# Analytics (optional; both are client-side public identifiers)
# Mixpanel project token
NEXT_PUBLIC_MIXPANEL_TOKEN=
# GA4 measurement id from Admin > Data streams, looks like G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
